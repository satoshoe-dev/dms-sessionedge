{
    "id": "sessionEdge",
    "name": "SessionEdge",
    "description": "Session actions (lock, suspend, log out, reboot, power off) in a slim strip that slides out of the frame when you hover a screen edge",
    "version": "1.1.0",
    "author": "satoshoe",
    "type": "composite",
    "capabilities": [
        "daemon"
    ],
    "components": {
        "daemon": "./SessionEdgeDaemon.qml"
    },
    "settings": "./SessionEdgeSettings.qml",
    "icon": "power_settings_new",
    "requires_dms": ">=1.6.1",
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
